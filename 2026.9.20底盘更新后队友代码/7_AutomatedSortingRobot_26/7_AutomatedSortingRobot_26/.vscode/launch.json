{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    // ============================================================
    // 烧录工具链（本机实测可用，2026-09-07 修正为 CubeIDE 1.19.0 内嵌工具链）：
    //   OpenOCD : plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/
    //              tools/bin/openocd.exe
    //   脚本目录: plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/
    //              resources/openocd/st_scripts        (与 flash.bat 完全同款)
    //   GDB     : plugins/...gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740/tools/bin/
    //              arm-none-eabi-gdb.exe
    //   注意：D:/downfile2/... (xpack 版) 工具链本机不存在，勿改回去
    // ============================================================
    // 行为说明（默认）：
    //   F5 = 烧录后自动全速运行，不停在 main（runToEntryPoint 已注释掉）。
    //   如需"停在 main 开始单步调试"，把对应配置里的
    //   "runToEntryPoint": "main" 那行取消注释即可。
    // ============================================================
    "version": "0.2.0",
    "configurations": [
        // ==================== 烧录选项 1：无线烧录（成品无线 DAP-Link 套装）====================
        // 电脑端 DAP-Link 插 USB 枚举为 CMSIS-DAP 调试器；板端 DAP-Link 接 STM32 SWD；
        // 两端无线配对，链路对 OpenOCD 透明。无线不稳定 → daplink_wireless.cfg 里已压到 500kHz
        {
            "name": "无线烧录 DAPLink F407",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/7_AutomatedSortingRobot_26.elf",
            "preLaunchTask": "Build STM32 Project",
            "servertype": "openocd",
            "serverpath": "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
            "configFiles": [
                // 无线接口配置（工程根目录）：CMSIS-DAP + SWD + 低速
                "daplink_wireless.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                // CubeIDE 脚本目录（含 interface/、target/），与 flash.bat 同款
                "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts",
                "${workspaceRoot}"          // 找工程根目录的 daplink_wireless.cfg
            ],
            // "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        // ==================== 烧录选项 2：有线烧录（ST-Link）====================
        {
            "name": "有线烧录 ST-Link F407",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/7_AutomatedSortingRobot_26.elf",
            "preLaunchTask": "Build STM32 Project",
            "servertype": "openocd",
            "serverpath": "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
            "configFiles": [
                // 注意：本机脚本里没有 stlink-v2.cfg，ST 新版统一用 interface/stlink.cfg（自动识别 v2/v3）
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts"
            ],
            // "runToEntryPoint": "main",   // 想让程序烧完停在 main 等调试再取消注释
            "showDevDebugOutput": "none"
        },
        // ==================== 烧录选项 3：有线烧录（DAP-Link）====================
        {
            "name": "有线烧录 DAPLink F407",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/7_AutomatedSortingRobot_26.elf",
            "preLaunchTask": "Build STM32 Project",
            "servertype": "openocd",
            "serverpath": "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "D:/STM32CubeIde/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts"
            ],
            // "runToEntryPoint": "main",   // 想让程序烧完停在 main 等调试再取消注释
            "showDevDebugOutput": "none"
        }
    ]
}
