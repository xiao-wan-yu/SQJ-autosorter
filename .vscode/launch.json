{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    // ============================================================
    // 烧录工具链（本机实测可用，与 8_ElectronicDesignContest_26 同款）：
    //   OpenOCD : D:/downfile2/xpack-openocd-0.12.0-7-...          (xpack 开源版)
    //   GDB     : D:/downfile2/xpack-arm-none-eabi-gcc-15.2.1-...  (xpack 工具链)
    //   勿用 STM32CubeIDE 内嵌工具链路径（D:/STM32CubeIde/...），本机不存在且缺 nm/gdb/openocd
    // ============================================================
    "version": "0.2.0",
    "configurations": [
        // ==================== 烧录选项 1：无线烧录（成品无线 DAP-Link 套装）====================
        // 电脑端 DAP-Link 插 USB 枚举为 CMSIS-DAP 调试器；板端 DAP-Link 接 STM32 SWD；
        // 两端无线配对，链路对 OpenOCD 透明。无线不稳定 → daplink_wireless.cfg 里已压到 500kHz
        {
            "name": "无线烧录 DAPLink F407",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/7_AutomatedSortingRobot_26.elf",
            "preLaunchTask": "Build STM32 Project",
            "servertype": "openocd",
            "serverpath": "D:/downfile2/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "configFiles": [
                // 无线接口配置（工程根目录）：CMSIS-DAP + SWD + 低速
                "daplink_wireless.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "D:/downfile2/xpack-arm-none-eabi-gcc-15.2.1-1.1-win32-x64/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "D:/downfile2/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts",
                "${workspaceRoot}"          // 找工程根目录的 daplink_wireless.cfg
            ],
            // "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        // ==================== 烧录选项 2：有线烧录（ST-Link）====================
        {
            "name": "有线烧录 ST-Link F407",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/7_AutomatedSortingRobot_26.elf",
            "preLaunchTask": "Build STM32 Project",
            "servertype": "openocd",
            "serverpath": "D:/downfile2/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "configFiles": [
                "interface/stlink-v2.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "D:/downfile2/xpack-arm-none-eabi-gcc-15.2.1-1.1-win32-x64/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "D:/downfile2/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        // ==================== 烧录选项 3：有线烧录（DAP-Link）====================
        {
            "name": "有线烧录 DAPLink F407",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/7_AutomatedSortingRobot_26.elf",
            "preLaunchTask": "Build STM32 Project",
            "servertype": "openocd",
            "serverpath": "D:/downfile2/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "D:/downfile2/xpack-arm-none-eabi-gcc-15.2.1-1.1-win32-x64/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "D:/downfile2/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}
